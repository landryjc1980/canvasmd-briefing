# Copy to .env.local. The anon key is publishable. The service-role key is used only
# by server routes to read/write finished Readout windows and must never be exposed to
# client code or given a NEXT_PUBLIC_ prefix.

SUPABASE_URL=https://zeqqxnaywtxofswujqub.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override; defaults to $SUPABASE_URL/functions/v1/briefing.
BRIEFING_FUNCTION_URL=

# Required for the reader gate and Vercel cache/archive cron routes.
BRIEF_SIGNING_SECRET=
CRON_SECRET=
